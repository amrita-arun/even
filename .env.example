# Project URL (Connect → Framework). Used for issuer + JWKS.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Backend (Spring Boot) — Connect → Session pooler (IPv4). Prefer this over Direct
# connection: db.*.supabase.co is IPv6-only and often fails with "nodename nor servname".
# Pooler username is postgres.YOUR_PROJECT_REF (not plain postgres).
SUPABASE_DB_URL=jdbc:postgresql://aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres?sslmode=require
SUPABASE_DB_USER=postgres.YOUR_PROJECT_REF
SUPABASE_DB_PASSWORD=
SUPABASE_JWKS_URL=https://YOUR_PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json

# Optional: legacy JWT Secret from Project Settings → API.
# Set this if access tokens are HS256 and JWKS verification returns 401.
# SUPABASE_JWT_SECRET=

# Frontend (Vite) — Connect → Framework / client library
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=

# Plaid (optional). Default is fixture mode (PLAID_LIVE=false) using checked-in sync pages.
# EVEN_TOKEN_ENCRYPTION_KEY=change-me-in-production
# PLAID_LIVE=false
# PLAID_CLIENT_ID=
# PLAID_SECRET=
# PLAID_ENV=sandbox
# PLAID_WEBHOOK_URL=https://your.host/api/plaid/webhooks
# PLAID_WEBHOOK_SECRET=
# PLAID_REDIRECT_URI=http://localhost:5173/connect
